page 3 (
    name: Employee
    alias: EMPLOYEE
    title: Employee
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @contribution-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region employee (
        name: Employee
        type: form
        source {
            location: localDatabase
            tableName: EMPLOYEES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P3_COMMISSION_PCT (
        type: numberField
        label {
            label: Commission Percent
            alignment: right
        }
        layout {
            sequence: 90
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-percent
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @employee
            column: COMMISSION_PCT
            dataType: number
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    pageItem P3_DEPARTMENT_ID (
        type: selectList
        label {
            label: Department
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @departments-department-name
        }
        layout {
            sequence: 110
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-sitemap
        }
        source {
            formRegion: @employee
            column: DEPARTMENT_ID
            dataType: number
        }
    )

    pageItem P3_EMAIL (
        type: textField
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 40
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            icon: fa-envelope
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 25
        }
        source {
            formRegion: @employee
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P3_EMPLOYEE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @employee
            slot: regionBody
        }
        source {
            formRegion: @employee
            column: EMPLOYEE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P3_FIRST_NAME (
        type: textField
        label {
            label: First Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @employee
            column: FIRST_NAME
            dataType: varchar2
        }
    )

    pageItem P3_HIRE_DATE (
        type: datePicker
        label {
            label: Hire Date
            alignment: right
        }
        layout {
            sequence: 60
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @employee
            column: HIRE_DATE
            dataType: date
        }
    )

    pageItem P3_JOB_ID (
        type: selectList
        label {
            label: Job
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @jobs-job-title
        }
        layout {
            sequence: 70
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            icon: fa-briefcase
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @employee
            column: JOB_ID
            dataType: varchar2
        }
    )

    pageItem P3_LAST_NAME (
        type: textField
        label {
            label: Last Name
            alignment: right
        }
        layout {
            sequence: 30
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 25
        }
        source {
            formRegion: @employee
            column: LAST_NAME
            dataType: varchar2
        }
    )

    pageItem P3_MANAGER_ID (
        type: selectList
        label {
            label: Manager
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @employees-first-name
        }
        layout {
            sequence: 100
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-user
        }
        source {
            formRegion: @employee
            column: MANAGER_ID
            dataType: number
        }
    )

    pageItem P3_PHONE_NUMBER (
        type: textField
        label {
            label: Phone Number
            alignment: right
        }
        layout {
            sequence: 50
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-phone
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @employee
            column: PHONE_NUMBER
            dataType: varchar2
        }
    )

    pageItem P3_SALARY (
        type: numberField
        label {
            label: Salary
            alignment: right
        }
        layout {
            sequence: 80
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-money
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @employee
            column: SALARY
            dataType: number
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: #DEFAULT#
            icon: fa-times
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_EMPLOYEE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--danger
                t-Button--simple
            ]
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_EMPLOYEE_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_EMPLOYEE_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 5597070987566430
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-employee (
        name: Initialize form Employee
        type: formInitialization
        formRegion: @employee
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 5596284983566420
        }
    )

    process process-form-employee (
        name: Process form Employee
        type: formAutoRowProcessing
        formRegion: @employee
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5596671057566423
        }
    )

)

