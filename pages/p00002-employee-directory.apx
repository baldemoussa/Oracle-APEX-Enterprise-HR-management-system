page 2 (
    name: Employee Directory
    alias: EMPLOYEE-DIRECTORY
    title: Employee Directory
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>Use the filters to narrow the employee list by department or job, or enter a search term to find employees by name and contact details.</p>
            <p>Select an employee name or the profile icon to view their details and office location. Use <strong>Reset</strong> to clear the filters.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region employee-directory (
        name: Employees
        type: classicReport
        source {
            location: localDatabase
            tableName: EMPLOYEES
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No data found.
        }

        column COMMISSION_PCT (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Commission Percent
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999990D00
            }
        )

        column DEPARTMENT_ID (
            reportColumnQueryId: 11
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Department
            }
            lov {
                type: sharedComponent
                lov: @departments-department-name
            }
            layout {
                sequence: 11
            }
            sorting {
                defaultSequence: 1
            }
        )

        column EMAIL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Email
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
            }
        )

        column EMPLOYEE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: <span class="u-VisuallyHidden">View employee</span>
                alignment: center
            }
            layout {
                sequence: 0
                columnAlignment: center
            }
            link {
                target: {
                    page: 13
                    items: {
                        P13_EMPLOYEE_ID: \#EMPLOYEE_ID#\
                    }
                    clearCache: 13
                }
                linkText: <span role="img" aria-label="View employee details" class="fa fa-id-card" title="View employee details"></span>
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                authorizationScheme: @reader-rights
            }
        )

        column FIRST_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: First Name
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column HIRE_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Hire Date
            }
            layout {
                sequence: 6
            }
        )

        column JOB_ID (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Job
            }
            lov {
                type: sharedComponent
                lov: @jobs-job-title
            }
            layout {
                sequence: 7
            }
            sorting {
                defaultSequence: 1
            }
        )

        column LAST_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: Last Name
            }
            layout {
                sequence: 3
            }
            link {
                target: {
                    page: 13
                    items: {
                        P13_EMPLOYEE_ID: \#EMPLOYEE_ID#\
                    }
                    clearCache: 13
                }
                linkText: #LAST_NAME#
            }
            sorting {
                defaultSequence: 1
            }
        )

        column MANAGER_ID (
            reportColumnQueryId: 10
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Manager
            }
            lov {
                type: sharedComponent
                lov: @employees-first-name
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PHONE_NUMBER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Phone Number
            }
            layout {
                sequence: 5
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SALARY (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Salary
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            security {
                authorizationScheme: @administration-rights
            }
        )

    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @employee-directory
        }
        layout {
            sequence: 10
            slot: leftColumn
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkLabel: Filters
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
        }

        facet P2_DEPARTMENT_ID (
            type: checkboxGroup
            label {
                label: Department
            }
            lov {
                type: sharedComponent
                lov: @departments-department-name
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: DEPARTMENT_ID
                dataType: number
            }
        )

        facet P2_JOB_ID (
            type: checkboxGroup
            label {
                label: Job
            }
            lov {
                type: sharedComponent
                lov: @jobs-job-title
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: JOB_ID
            }
        )

        facet P2_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: FIRST_NAME,LAST_NAME,EMAIL,PHONE_NUMBER,JOB_ID
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                clearCache: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
                clearCache: 2
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

