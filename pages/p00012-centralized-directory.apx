page 12 (
    name: Centralized Directory
    alias: CENTRALIZED-DIRECTORY
    title: Centralized Directory
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @search-results
        }
        layout {
            sequence: 10
            slot: leftColumn
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkLabel: Filters
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
            displayChartForTopNValues: 10
        }

        facet P12_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: JOB_ID,COUNTRY_ID,FIRST_NAME,LAST_NAME,DEPARTMENT_NAME,JOB_TITLE,CITY,STATE_PROVINCE,COUNTRY_NAME,REGION_NAME
            }
        )

    )

    region search-results (
        name: Emp Details View
        type: classicReport
        source {
            location: localDatabase
            tableName: EMP_DETAILS_VIEW
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No data found.
        }

        column CITY (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 13
            }
            sorting {
                defaultSequence: 1
            }
        )

        column COMMISSION_PCT (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Commission Percent
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column COUNTRY_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Country ID
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
        )

        column COUNTRY_NAME (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 15
            }
            sorting {
                defaultSequence: 1
            }
        )

        column DEPARTMENT_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column DEPARTMENT_NAME (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 11
            }
            sorting {
                defaultSequence: 1
            }
        )

        column EMPLOYEE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column FIRST_NAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: First Name
            }
            layout {
                sequence: 7
            }
            sorting {
                defaultSequence: 1
            }
        )

        column JOB_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Job ID
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column JOB_TITLE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 12
            }
            sorting {
                defaultSequence: 1
            }
        )

        column LAST_NAME (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Last Name
            }
            layout {
                sequence: 8
            }
            sorting {
                defaultSequence: 1
            }
        )

        column LOCATION_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column MANAGER_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column REGION_NAME (
            reportColumnQueryId: 16
            derivedColumn: N
            type: hidden
            layout {
                sequence: 16
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SALARY (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Salary
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            security {
                authorizationScheme: @administration-rights
            }
        )

        column STATE_PROVINCE (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 14
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                clearCache: 12
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

