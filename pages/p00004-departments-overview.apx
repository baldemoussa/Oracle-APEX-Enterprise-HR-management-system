page 4 (
    name: Departments Overview
    alias: DEPARTMENTS-OVERVIEW
    title: Departments Overview
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.</p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region departments-overview (
        name: Departments
        type: interactiveReport
        source {
            location: localDatabase
            tableName: DEPARTMENTS
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 5
                items: {
                    P5_DEPARTMENT_ID: \#DEPARTMENT_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @contribution-rights
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 5614274405570403
        }

        column DEPARTMENT_ID (
            type: hidden
            heading {
                heading: Department ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column DEPARTMENT_NAME (
            type: plainText
            heading {
                heading: Department Name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column LOCATION_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Location
            }
            lov {
                lov: @locations-street-address
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column MANAGER_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Manager
            }
            lov {
                lov: @employees-first-name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEPARTMENT_NAME (
                sequence: 1
            )

            displayColumn LOCATION_ID (
                sequence: 3
            )

            displayColumn MANAGER_ID (
                sequence: 2
            )

            sort (
                column: DEPARTMENT_NAME
                sort {
                    sequence: 1
                }
            )

        )

    )

    region employee-management-tree (
        name: Employee Management Hierarchy
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case
                           when connect_by_isleaf = 1 then 0
                           when level = 1 then 1
                           else -1
                       end as status,
                       level,
                       e."FIRST_NAME" || ' ' || e."LAST_NAME" ||
                       ' - ' || j."JOB_TITLE" as title,
                       case
                           when connect_by_isleaf = 1 then 'fa fa-user'
                           else 'fa fa-users'
                       end as icon,
                       e."EMPLOYEE_ID" as employee_id,
                       e."MANAGER_ID" as manager_id,
                       e."EMPLOYEE_ID" as value,
                       e."EMAIL" || ' · ' || j."JOB_TITLE" as tooltip,
                       cast(null as varchar2(4000)) as link
                  from "EMPLOYEES" e
                  join "JOBS" j
                    on j."JOB_ID" = e."JOB_ID"
                 start with e."MANAGER_ID" is null
               connect by nocycle prior e."EMPLOYEE_ID" = e."MANAGER_ID"
                 order siblings by e."LAST_NAME", e."FIRST_NAME"
                ```
        }
        settings {
            nodeLabelColumn: TITLE
            nodeIdColumn: EMPLOYEE_ID
            parentKeyColumn: MANAGER_ID
        }
        layout {
            sequence: 15
            slot: body
            columnSpan: 6
            startNewRow: false
            newColumn: true
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
            ]
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @departments-overview
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @departments-overview
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @departments-overview
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

