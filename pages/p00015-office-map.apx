page 15 (
    name: Office Map
    alias: OFFICE-MAP
    title: Office Map
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region map (
        name: Map
        type: map
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        map {
            background: builtIn
            standard: openstreetmapPositron
            height: 520
        }
        controls {
            navigationBar: zoomOnly
            options: [
                scaleBar
                mousewheelZoom
            ]
        }
        initialPositionAndZoom {
            type: staticValues
            longitude: -55
            latitude: 42
            zoomLevel: 2
        }
        attributes {
            messagesPosition: below
        }

        layer office-map (
            name: Office Map
            layerType: polygons
            layout {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery:
                    ```sql
                    with employee_counts as (
                        select l."COUNTRY_ID",
                               count(e."EMPLOYEE_ID") "EMPLOYEE_COUNT"
                          from "DEPARTMENTS" d
                          join "LOCATIONS" l
                            on l."LOCATION_ID" = d."LOCATION_ID"
                          left join "EMPLOYEES" e
                            on e."DEPARTMENT_ID" = d."DEPARTMENT_ID"
                         group by l."COUNTRY_ID"
                    ),
                    country_polygons as (
                        -- Natural Earth 1:110m country boundaries for HR countries with employees.
                        select 'US' "COUNTRY_ID", to_clob(q'~{"type":"MultiPolygon","coordinates":[[[[-122.84,49],[-95.159,49],[-94.818,49.389],[-94.329,48.671],[-91.64,48.14],[-88.378,48.303],[-84.876,46.9],[-82.551,45.348],[-82.138,43.571],[-83.12,42.08],[-82.69,41.675],[-78.939,42.864],[-79.172,43.466],[-78.72,43.625],[-76.82,43.629],[-74.867,45.0],[-71.505,45.008],[-70.66,45.46],[-69.237,47.448],[-67.79,47.066],[-67.791,45.703],[-66.965,44.81],[-70.116,43.684],[-70.825,42.335],[-69.965,41.637],[-73.71,40.931],[-71.945,40.93],[-73.952,40.751],[-74.906,38.94],[-75.528,39.498],[-75.057,38.404],[-75.94,37.217],[-75.722,37.937],[-76.35,39.15],[-76.329,38.083],[-76.99,38.24],[-76.302,37.918],[-75.727,35.551],[-79.061,33.494],[-81.336,31.44],[-81.314,30.036],[-80.057,26.88],[-80.381,25.206],[-81.172,25.201],[-81.71,25.87],[-82.855,27.886],[-82.65,28.55],[-83.71,29.937],[-85.109,29.636],[-86.4,30.4],[-89.594,30.16],[-89.408,29.16],[-93.226,29.784],[-94.69,29.48],[-97.14,27.83],[-97.14,25.87],[-97.53,25.84],[-99.02,26.37],[-100.958,29.381],[-102.48,29.76],[-103.11,28.97],[-103.94,29.27],[-106.508,31.755],[-111.024,31.335],[-114.721,32.721],[-117.128,32.535],[-118.52,34.028],[-120.623,34.609],[-124.398,40.313],[-124.533,42.766],[-123.899,45.523],[-124.687,48.184],[-123.12,48.04],[-122.587,47.096],[-122.84,49]]],[[[-155.402,20.08],[-154.807,19.509],[-155.688,18.916],[-156.073,19.703],[-155.861,20.267],[-155.402,20.08]]],[[[-155.99566,20.76404],[-156.07926,20.64397],[-156.41445,20.57241],[-156.58673,20.783],[-156.70167,20.8643],[-156.71055,20.92676],[-156.61258,21.01249],[-156.25711,20.91745],[-155.99566,20.76404]]],[[[-156.75824,21.17684],[-156.78933,21.06873],[-157.32521,21.09777],[-157.25027,21.21958],[-156.75824,21.17684]]],[[[-158.025,21.717],[-157.707,21.264],[-158.127,21.312],[-158.025,21.717]]],[[[-159.36569,22.21494],[-159.34512,21.982],[-159.46372,21.88299],[-159.80051,22.06533],[-159.74877,22.1382],[-159.5962,22.23618],[-159.36569,22.21494]]],[[[-166.468,60.384],[-165.579,59.91],[-167.455,60.213],[-166.468,60.384]]],[[[-153.229,57.969],[-152.141,57.591],[-154.005,56.735],[-154.516,56.993],[-154.671,57.461],[-153.229,57.969]]],[[[-140.986,69.712],[-140.998,60.306],[-139.039,60],[-137.452,58.905],[-135.476,59.788],[-133.356,58.41],[-131.708,56.552],[-130.008,55.916],[-130.536,54.803],[-131.967,55.498],[-132.25,56.37],[-133.539,57.179],[-134.078,58.123],[-136.628,58.212],[-139.868,59.538],[-147.114,60.885],[-148.224,60.673],[-148.018,59.978],[-151.716,59.156],[-151.41,60.726],[-150.347,61.034],[-150.621,61.284],[-154.019,59.35],[-153.288,58.865],[-154.232,58.146],[-156.308,57.423],[-158.433,55.994],[-164.942,54.572],[-158.684,57.017],[-157.723,57.57],[-157.042,58.919],[-159.059,58.424],[-160.355,59.071],[-161.969,58.672],[-161.874,59.634],[-162.518,59.99],[-163.818,59.798],[-165.346,60.507],[-165.351,61.074],[-166.121,61.5],[-165.734,62.075],[-164.563,63.146],[-163.067,63.059],[-160.773,63.766],[-161.518,64.403],[-160.778,64.789],[-164.961,64.447],[-166.425,64.687],[-168.111,65.67],[-164.475,66.577],[-163.653,66.577],[-163.789,66.077],[-161.678,66.116],[-166.764,68.359],[-166.205,68.883],[-164.431,68.916],[-161.909,70.333],[-156.581,71.358],[-154.344,70.696],[-140.986,69.712]]],[[[-171.732,63.783],[-168.689,63.298],[-169.529,62.977],[-171.553,63.318],[-171.732,63.783]]]]}~') "GEOJSON" from dual
                        union all
                        select 'CA' "COUNTRY_ID", to_clob(q'~{"type":"MultiPolygon","coordinates":[[[[-122.84,49],[-127.436,50.831],[-130.515,54.288],[-130.008,55.916],[-135.476,59.788],[-137.452,58.905],[-140.998,60.306],[-140.986,69.712],[-136.504,68.898],[-128.138,70.484],[-113.497,67.688],[-106.15,68.8],[-101.454,67.647],[-97.669,68.579],[-96.126,67.293],[-94.233,69.069],[-96.471,70.09],[-95.209,71.921],[-87.35,67.199],[-85.522,69.882],[-82.623,69.658],[-81.387,67.111],[-85.769,66.558],[-90.704,63.61],[-94.685,58.949],[-92.297,57.087],[-82.273,55.148],[-79.913,51.208],[-78.602,52.562],[-79.83,54.668],[-76.541,56.534],[-78.517,58.805],[-77.337,59.853],[-78.107,62.32],[-73.84,62.444],[-69.59,61.061],[-67.65,58.212],[-64.584,60.336],[-61.799,56.339],[-57.333,54.627],[-55.683,52.147],[-60.033,50.243],[-66.399,50.229],[-71.105,46.822],[-65.056,49.233],[-64.472,46.238],[-60.518,47.008],[-59.803,45.92],[-65.364,43.545],[-66.162,44.465],[-64.425,45.292],[-67.137,45.138],[-69.237,47.448],[-71.505,45.008],[-82.439,41.675],[-82.551,45.348],[-88.378,48.303],[-122.84,49]]],[[[-88.15,74.392],[-97.121,76.751],[-79.834,74.923],[-88.15,74.392]]],[[[-55.6,51.317],[-56.796,49.812],[-53.477,49.249],[-53.069,46.655],[-59.266,47.603],[-55.6,51.317]]],[[[-83.883,65.11],[-80.103,63.726],[-87.222,63.541],[-85.884,65.739],[-83.883,65.11]]],[[[-78.771,72.352],[-68.786,70.525],[-66.969,69.186],[-68.805,68.72],[-61.852,66.862],[-63.918,64.999],[-68.015,66.263],[-64.669,63.393],[-68.783,63.746],[-66.166,61.931],[-68.877,62.33],[-78.556,64.573],[-73.96,65.455],[-73.312,68.069],[-78.957,70.167],[-88.682,70.411],[-90.205,72.235],[-85.826,73.804],[-85.774,72.534],[-82.316,73.751],[-78.771,72.352]]],[[[-94.504,74.135],[-90.51,73.857],[-95.41,72.062],[-96.018,73.437],[-94.504,74.135]]],[[[-122.854924,76.116543],[-122.854925,76.116543],[-121.157535,76.864508],[-119.103939,77.51222],[-117.570131,77.498319],[-116.198587,77.645287],[-116.335813,76.876962],[-117.106051,76.530032],[-118.040412,76.481172],[-119.899318,76.053213],[-121.499995,75.900019],[-122.854924,76.116543]]],[[[-121.538,74.449],[-115.511,73.475],[-123.092,70.902],[-125.929,71.869],[-123.94,73.68],[-124.918,74.293],[-121.538,74.449]]],[[[-107.819,75.846],[-105.705,75.48],[-117.71,75.222],[-115.405,76.479],[-107.819,75.846]]],[[[-106.523,73.076],[-101.089,69.584],[-113.313,68.536],[-117.34,69.96],[-112.416,70.366],[-119.402,71.559],[-115.189,73.315],[-108.188,71.651],[-108.396,73.09],[-106.523,73.076]]],[[[-100.438,72.706],[-101.54,73.36],[-97.38,73.76],[-96.54,72.56],[-98.36,71.273],[-102.5,72.51],[-100.438,72.706]]],[[[-98.5,76.72],[-98.16,75],[-102.502,75.564],[-98.5,76.72]]],[[[-96.016,80.602],[-92.41,81.257],[-85.814,79.337],[-92.877,78.343],[-96.016,80.602]]],[[[-91.587,81.894],[-61.85,82.629],[-76.908,79.323],[-75.393,78.526],[-80.561,76.178],[-89.491,76.472],[-88.26,77.9],[-84.976,77.539],[-87.962,78.372],[-85.095,79.345],[-86.932,80.251],[-81.848,80.464],[-91.587,81.894]]]]}~') "GEOJSON" from dual
                        union all
                        select 'UK' "COUNTRY_ID", to_clob(q'~{"type":"MultiPolygon","coordinates":[[[[-6.198,53.868],[-7.572,54.06],[-7.572,55.132],[-5.662,54.555],[-6.198,53.868]]],[[[-3.094,53.405],[-2.945,53.985],[-3.63,54.615],[-5.083,55.062],[-4.719,55.508],[-5.048,55.784],[-5.586,55.311],[-6.15,56.785],[-5.01,58.63],[-3.005,58.635],[-4.074,57.553],[-1.959,57.685],[-3.119,55.974],[-2.085,55.91],[-1.115,54.625],[-0.43,54.464],[0.47,52.93],[1.682,52.74],[1.051,51.807],[1.45,51.289],[0.55,50.766],[-5.777,50.16],[-3.415,51.426],[-5.267,51.991],[-4.222,52.301],[-4.77,52.84],[-4.58,53.495],[-3.094,53.405]]]]}~') "GEOJSON" from dual
                        union all
                        select 'DE' "COUNTRY_ID", to_clob(q'~{"type":"MultiPolygon","coordinates":[[[[14.12,53.757],[15.017,51.107],[12.24,50.266],[12.521,49.547],[13.596,48.877],[12.884,48.289],[12.933,47.468],[7.467,47.621],[8.099,49.018],[6.658,49.202],[6.043,50.128],[5.989,51.852],[6.843,52.228],[7.1,53.694],[8.122,53.528],[8.801,54.021],[8.526,54.963],[9.922,54.983],[10.939,54.009],[12.518,54.47],[14.12,53.757]]]]}~') "GEOJSON" from dual
                    )
                    select c."COUNTRY_ID",
                           c."COUNTRY_NAME",
                           ec."EMPLOYEE_COUNT",
                           cp."GEOJSON",
                           c."COUNTRY_NAME" || ' - Employees: ' ||
                           to_char(ec."EMPLOYEE_COUNT") "MAP_TOOLTIP"
                      from country_polygons cp
                      join "COUNTRIES" c
                        on c."COUNTRY_ID" = cp."COUNTRY_ID"
                      join employee_counts ec
                        on ec."COUNTRY_ID" = c."COUNTRY_ID"
                     where ec."EMPLOYEE_COUNT" > 0
                    ```
            }
            columnMapping {
                primaryKeyColumn: COUNTRY_ID
                geometryColumnDataType: geojson
                geojsonColumn: GEOJSON
            }
            appearance {
                useColorScheme: true
                colorValueColumn: EMPLOYEE_COUNT
                colorScheme: sequential
                schemeName: burgundyToYellow
                strokeColor: "#FFFFFF"
                strokeWidth: 1
                fillOpacity: 0.8
            }
            tooltip {
                column: MAP_TOOLTIP
            }
            legend {
                show: true
            }
        )

    )

)

