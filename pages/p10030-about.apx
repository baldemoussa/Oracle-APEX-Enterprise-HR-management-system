page 10030 (
    name: About
    alias: ABOUT
    title: About
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    help {
        helpText: All application help text can be accessed from this page. The links in the "Documentation" region give a much more in-depth explanation of the application's features and functionality.
    }
    config {
        buildOption: @feature-about-page
    }

    region about-page (
        name: About Page
        type: staticContent
        source {
            htmlCode: <h2>Enterprise HR Management System</h2><p>Manage employee and organizational records, review workforce reports, and maintain office information. Access to employee compensation is restricted to Administrators.</p><p>For access or data corrections, contact your HR system administrator.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--padded
                t-ContentBlock--h1
                t-ContentBlock--lightBG
            ]
        }
    )

)

